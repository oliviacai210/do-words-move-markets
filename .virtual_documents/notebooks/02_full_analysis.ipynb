def top_terms_dict(result, n=12):
    terms = {}
    for topic_id in range(result['lda'].num_topics):
        for term, weight in result['lda'].show_topic(topic_id, topn=n):
            terms[term] = max(terms.get(term, 0), weight)
    return terms

